# 模型供应商 API Key（必需；默认对接智谱 GLM，也可换任意 OpenAI 兼容供应商）
# 默认供应商获取地址：https://bigmodel.cn → API 密钥
# 换供应商：另设 LLM_BASE_URL 与模型名变量（见 README 配置节）
LLM_API_KEY="your-api-key-here"

# Notion Integration Token（可选，仅在使用 Notion 工具时需要）
# 获取地址：https://www.notion.so/my-integrations
NOTION_TOKEN="your-notion-token-here"

# MCP 研究工具独立认证（可选）：不设则与 LLM_API_KEY 共用——
# 「别家 LLM + 智谱 MCP」场景在这里填智谱 Key，LLM_API_KEY 填别家
# MCP_API_KEY="your-bigmodel-key-here"

# ===== 以下均为可选项（默认值适用于智谱官方端点，一般无需配置）=====
# 模型供应商 OpenAI 兼容端点（自建代理/兼容网关时覆盖）
# LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4/"
# 主 Agent 模型 / 子 Agent 通用模型 / repo_analyzer 专用模型
# LLM_MAIN_MODEL="glm-5"
# LLM_SUB_MODEL="glm-5-turbo"
# LLM_REPO_MODEL="glm-5"
# MCP 三端点（默认智谱官方）
# MCP_WEB_SEARCH_URL="https://open.bigmodel.cn/api/mcp/web_search_prime/mcp"
# MCP_WEB_READER_URL="https://open.bigmodel.cn/api/mcp/web_reader/mcp"
# MCP_ZREAD_URL="https://open.bigmodel.cn/api/mcp/zread/mcp"
